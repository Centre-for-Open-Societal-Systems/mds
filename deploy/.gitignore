# Secrets and server-only files: they live only on the MDS-dev-staging server.
*.pem
ansible/environments/*/vault.yml
ansible/inventory/group_vars/all/vault.yml
ansible/inventory/hosts.ini
ansible/.vault_pass
ansible/artifacts/
ansible/collections/
infra/terraform/**/.terraform/
infra/terraform/**/*.tfstate*
infra/terraform/**/terraform.tfvars
