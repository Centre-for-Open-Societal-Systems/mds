---
apiVersion: v1
kind: Service
metadata:
  name: mds-api
  namespace: {{ mds_namespace }}
  labels: { app.kubernetes.io/name: mds-api, app.kubernetes.io/part-of: openg2p-mds }
spec:
  type: ClusterIP
  selector: { app.kubernetes.io/name: mds-api }
  ports:
    - { name: http, port: 8000, targetPort: 8000 }
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: mds-api
  namespace: {{ mds_namespace }}
  labels: { app.kubernetes.io/name: mds-api, app.kubernetes.io/part-of: openg2p-mds }
spec:
{% if not mds_hpa_enabled %}
  replicas: {{ mds_api_replicas }}
{% endif %}
  revisionHistoryLimit: 10
  strategy:
    type: RollingUpdate
    rollingUpdate: { maxUnavailable: {{ mds_rollout_max_unavailable }}, maxSurge: {{ mds_rollout_max_surge }} }
  selector:
    matchLabels: { app.kubernetes.io/name: mds-api }
  template:
    metadata:
      labels: { app.kubernetes.io/name: mds-api, app.kubernetes.io/part-of: openg2p-mds }
      annotations:
        checksum/config: {{ lookup('ansible.builtin.template', 'configmaps.yaml.j2') | hash('sha256') }}
        checksum/login: {{ (mds_standalone_login_username ~ ':' ~ (vault_standalone_login_password | default(''))) | hash('sha256') }}
    spec:
{% if mds_image_pull_secret | length > 0 %}
      imagePullSecrets:
        - name: {{ mds_image_pull_secret }}
{% endif %}
      topologySpreadConstraints:
        - maxSkew: 1
          topologyKey: kubernetes.io/hostname
          whenUnsatisfiable: ScheduleAnyway
          labelSelector:
            matchLabels: { app.kubernetes.io/name: mds-api }
      initContainers:
        - name: wait-for-postgres
          image: {{ mds_postgres_image }}
          command: ["sh", "-c", "until pg_isready -h mds-postgres -p 5432; do echo waiting for postgres; sleep 3; done"]
        - name: wait-for-minio
          image: {{ mds_busybox_image }}
          command: ["sh", "-c", "until wget -q -O /dev/null http://mds-minio:9000/minio/health/ready; do echo waiting for minio; sleep 3; done"]
      containers:
        - name: api
          image: {{ mds_api_image }}
          imagePullPolicy: {{ mds_image_pull_policy | default("IfNotPresent") }}
{% if mds_api_start_command | length > 0 %}
          command: ["/bin/sh", "-c"]
          args:
            - |
              set -e
              if [ "$MASTER_DATA_API_AUTH_ENABLED" = "false" ] && [ -f /opt/mds-hooks/patch_api.py ]; then
                echo "[standalone] applying patch_api.py"
                python /opt/mds-hooks/patch_api.py
              fi
              exec {{ mds_api_start_command }}
{% endif %}
          ports:
            - { name: http, containerPort: 8000 }
          envFrom:
            - configMapRef: { name: mds-api-config }
          env:
            - name: {{ mds_api_db_env_names.dbname }}
              valueFrom: { secretKeyRef: { name: mds-postgres, key: POSTGRES_DB } }
            - name: {{ mds_api_db_env_names.user }}
              valueFrom: { secretKeyRef: { name: mds-postgres, key: POSTGRES_USER } }
            - name: {{ mds_api_db_env_names.password }}
              valueFrom: { secretKeyRef: { name: mds-postgres, key: POSTGRES_PASSWORD } }
            # Same DB for openg2p-fastapi-common (builds the engine; see configmaps.yaml.j2)
            - name: COMMON_DB_DBNAME
              valueFrom: { secretKeyRef: { name: mds-postgres, key: POSTGRES_DB } }
            - name: COMMON_DB_USERNAME
              valueFrom: { secretKeyRef: { name: mds-postgres, key: POSTGRES_USER } }
            - name: COMMON_DB_PASSWORD
              valueFrom: { secretKeyRef: { name: mds-postgres, key: POSTGRES_PASSWORD } }
            - name: {{ mds_api_minio_env_names.access_key }}
              valueFrom: { secretKeyRef: { name: mds-minio, key: MINIO_ROOT_USER } }
            - name: {{ mds_api_minio_env_names.secret_key }}
              valueFrom: { secretKeyRef: { name: mds-minio, key: MINIO_ROOT_PASSWORD } }
{% if mds_standalone_mode %}
            # Read by sitecustomize.py: only the standalone login's token is accepted.
            - name: MDS_LOGIN_USERNAME
              valueFrom: { secretKeyRef: { name: mds-login, key: MDS_LOGIN_USERNAME } }
            - name: MDS_LOGIN_PASSWORD
              valueFrom: { secretKeyRef: { name: mds-login, key: MDS_LOGIN_PASSWORD } }
{% endif %}
{% if not mds_standalone_mode %}
            - name: KEYCLOAK_CLIENT_SECRET
              valueFrom: { secretKeyRef: { name: mds-iam, key: KEYCLOAK_CLIENT_SECRET } }
{% endif %}
          startupProbe:
            httpGet: { path: /ping, port: 8000 }
            periodSeconds: 5
            failureThreshold: 60
          readinessProbe:
            httpGet: { path: /ping, port: 8000 }
            periodSeconds: 10
            timeoutSeconds: 5
          livenessProbe:
            httpGet: { path: /ping, port: 8000 }
            periodSeconds: 20
            timeoutSeconds: 5
            failureThreshold: 3
          resources: {{ mds_api_resources | to_json }}
          volumeMounts:
            - { name: hooks, mountPath: /opt/mds-hooks, readOnly: true }
      volumes:
        - name: hooks
          configMap: { name: mds-hooks }
