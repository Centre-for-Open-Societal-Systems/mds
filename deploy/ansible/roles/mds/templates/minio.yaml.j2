---
apiVersion: v1
kind: Service
metadata:
  name: mds-minio
  namespace: {{ mds_namespace }}
  labels: { app.kubernetes.io/name: mds-minio, app.kubernetes.io/part-of: openg2p-mds }
spec:
  type: ClusterIP
  selector: { app.kubernetes.io/name: mds-minio }
  ports:
    - { name: api, port: 9000, targetPort: 9000 }
    - { name: console, port: 9001, targetPort: 9001 }
---
apiVersion: apps/v1
kind: StatefulSet
metadata:
  name: mds-minio
  namespace: {{ mds_namespace }}
  labels: { app.kubernetes.io/name: mds-minio, app.kubernetes.io/part-of: openg2p-mds }
spec:
  serviceName: mds-minio
  replicas: 1
  selector:
    matchLabels: { app.kubernetes.io/name: mds-minio }
  template:
    metadata:
      labels: { app.kubernetes.io/name: mds-minio, app.kubernetes.io/part-of: openg2p-mds }
    spec:
      securityContext:
        runAsUser: 1000
        runAsGroup: 1000
        fsGroup: 1000
      containers:
        - name: minio
          image: {{ mds_minio_image }}
          imagePullPolicy: IfNotPresent
          args: ["server", "/data", "--console-address", ":9001"]
          ports:
            - { name: api, containerPort: 9000 }
            - { name: console, containerPort: 9001 }
          envFrom:
            - secretRef: { name: mds-minio }
{% if mds_expose_minio_console %}
          env:
            - name: MINIO_BROWSER_REDIRECT_URL
              value: https://{{ mds_minio_console_host }}
{% endif %}
          readinessProbe:
            httpGet: { path: /minio/health/ready, port: 9000 }
            initialDelaySeconds: 5
            periodSeconds: 10
          livenessProbe:
            httpGet: { path: /minio/health/live, port: 9000 }
            initialDelaySeconds: 20
            periodSeconds: 20
          resources: {{ mds_minio_resources | to_json }}
          volumeMounts:
            - { name: data, mountPath: /data }
  volumeClaimTemplates:
    - metadata:
        name: data
      spec:
        accessModes: ["ReadWriteOnce"]
        storageClassName: {{ mds_storage_class }}
        resources:
          requests:
            storage: {{ mds_minio_storage }}
