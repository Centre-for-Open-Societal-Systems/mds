---
apiVersion: v1
kind: Service
metadata:
  name: mds-ui
  namespace: {{ mds_namespace }}
  labels: { app.kubernetes.io/name: mds-ui, app.kubernetes.io/part-of: openg2p-mds }
spec:
  type: ClusterIP
  selector: { app.kubernetes.io/name: mds-ui }
  ports:
    - { name: http, port: 3000, targetPort: 3000 }
{% if mds_standalone_mode %}
---
# Browser-facing part of the mock IAM (login callback / logout), routed by the UI ingress at /mock-iam.
apiVersion: v1
kind: Service
metadata:
  name: mds-mock-iam
  namespace: {{ mds_namespace }}
  labels: { app.kubernetes.io/name: mds-mock-iam, app.kubernetes.io/part-of: openg2p-mds }
spec:
  type: ClusterIP
  selector: { app.kubernetes.io/name: mds-ui }
  ports:
    - { name: http, port: 8020, targetPort: 8020 }
{% endif %}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: mds-ui
  namespace: {{ mds_namespace }}
  labels: { app.kubernetes.io/name: mds-ui, app.kubernetes.io/part-of: openg2p-mds }
spec:
{% if not mds_hpa_enabled %}
  replicas: {{ mds_ui_replicas }}
{% endif %}
  revisionHistoryLimit: 10
  strategy:
    type: RollingUpdate
    rollingUpdate: { maxUnavailable: {{ mds_rollout_max_unavailable }}, maxSurge: {{ mds_rollout_max_surge }} }
  selector:
    matchLabels: { app.kubernetes.io/name: mds-ui }
  template:
    metadata:
      labels: { app.kubernetes.io/name: mds-ui, app.kubernetes.io/part-of: openg2p-mds }
      annotations:
        checksum/config: {{ lookup('ansible.builtin.template', 'configmaps.yaml.j2') | hash('sha256') }}
        checksum/login: {{ (mds_standalone_login_username ~ ':' ~ (vault_standalone_login_password | default(''))) | hash('sha256') }}
    spec:
{% if mds_image_pull_secret | length > 0 %}
      imagePullSecrets:
        - name: {{ mds_image_pull_secret }}
{% endif %}
      topologySpreadConstraints:
        - maxSkew: 1
          topologyKey: kubernetes.io/hostname
          whenUnsatisfiable: ScheduleAnyway
          labelSelector:
            matchLabels: { app.kubernetes.io/name: mds-ui }
      containers:
        - name: ui
          image: {{ mds_ui_image }}
          imagePullPolicy: {{ mds_image_pull_policy | default("IfNotPresent") }}
{% if mds_standalone_mode and mds_ui_start_command | length > 0 %}
          # Run the standalone hooks (auth helpers + sidebar) before Next.js starts.
          command: ["/bin/sh", "-c"]
          args:
            - |
              set -e
              for hook in patch_ui.js customize_sidebar.js reorder_sidebar.js; do
                if [ -f "/opt/mds-hooks/$hook" ]; then
                  echo "[standalone] applying $hook"
                  node "/opt/mds-hooks/$hook"
                fi
              done
              exec {{ mds_ui_start_command }}
{% endif %}
          ports:
            - { name: http, containerPort: 3000 }
          envFrom:
            - configMapRef: { name: mds-ui-config }
          env:
            - name: HOSTNAME
              value: "0.0.0.0"
            - name: PORT
              value: "3000"
          startupProbe:
            httpGet: { path: /en, port: 3000 }
            periodSeconds: 5
            failureThreshold: 60
          readinessProbe:
            httpGet: { path: /en, port: 3000 }
            periodSeconds: 10
            timeoutSeconds: 5
          livenessProbe:
            httpGet: { path: /en, port: 3000 }
            periodSeconds: 30
            timeoutSeconds: 5
            failureThreshold: 3
          resources: {{ mds_ui_resources | to_json }}
          volumeMounts:
            - { name: hooks, mountPath: /opt/mds-hooks, readOnly: true }
{% if mds_standalone_mode %}
        # Mock IAM (replaces the external OpenG2P IAM on :8020). Same pod => reachable at localhost:8020.
        - name: mock-iam
          image: {{ mds_node_image }}
          imagePullPolicy: IfNotPresent
          command: ["node", "/opt/mds-hooks/mock_iam.js"]
          envFrom:
            - configMapRef: { name: mds-ui-config }
          env:
            - name: MDS_LOGIN_USERNAME
              valueFrom: { secretKeyRef: { name: mds-login, key: MDS_LOGIN_USERNAME } }
            - name: MDS_LOGIN_PASSWORD
              valueFrom: { secretKeyRef: { name: mds-login, key: MDS_LOGIN_PASSWORD } }
{% if mds_keycloak_enabled %}
            # Created by playbook 05-keycloak.yml.
            - name: MDS_KEYCLOAK_CLIENT_SECRET
              valueFrom: { secretKeyRef: { name: mds-keycloak, key: KEYCLOAK_CLIENT_SECRET } }
{% endif %}
          ports:
            - { name: mock-iam, containerPort: 8020 }
          readinessProbe:
            tcpSocket: { port: 8020 }
            periodSeconds: 10
          livenessProbe:
            tcpSocket: { port: 8020 }
            periodSeconds: 30
          resources:
            requests: { cpu: 10m, memory: 32Mi }
            limits: { cpu: 100m, memory: 128Mi }
          securityContext:
            runAsNonRoot: true
            runAsUser: 1000
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
          volumeMounts:
            - { name: hooks, mountPath: /opt/mds-hooks, readOnly: true }
{% endif %}
      volumes:
        - name: hooks
          configMap: { name: mds-hooks }
