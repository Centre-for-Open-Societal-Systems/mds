---
apiVersion: batch/v1
kind: Job
metadata:
  name: mds-minio-init
  namespace: {{ mds_namespace }}
  labels: { app.kubernetes.io/name: mds-minio-init, app.kubernetes.io/part-of: openg2p-mds }
spec:
  backoffLimit: 6
  ttlSecondsAfterFinished: 3600
  template:
    metadata:
      labels: { app.kubernetes.io/name: mds-minio-init, app.kubernetes.io/part-of: openg2p-mds }
    spec:
      restartPolicy: OnFailure
      containers:
        - name: mc
          image: {{ mds_mc_image }}
          command: ["/bin/sh", "-c"]
          args:
            - |
              set -e
              mc alias set local http://mds-minio:9000 "$MINIO_ROOT_USER" "$MINIO_ROOT_PASSWORD"
              mc mb --ignore-existing local/{{ mds_minio_bucket }}
              mc anonymous set none local/{{ mds_minio_bucket }}
              mc version enable local/{{ mds_minio_bucket }} || true
              mc ls local/
          envFrom:
            - secretRef: { name: mds-minio }
          env:
            - name: MC_CONFIG_DIR
              value: /tmp/.mc
