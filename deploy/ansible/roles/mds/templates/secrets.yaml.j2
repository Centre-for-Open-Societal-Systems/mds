---
apiVersion: v1
kind: Secret
metadata:
  name: mds-postgres
  namespace: {{ mds_namespace }}
type: Opaque
stringData:
  POSTGRES_USER: {{ mds_postgres_user | to_json }}
  POSTGRES_PASSWORD: {{ vault_postgres_password | to_json }}
  POSTGRES_DB: {{ mds_postgres_db | to_json }}
---
apiVersion: v1
kind: Secret
metadata:
  name: mds-minio
  namespace: {{ mds_namespace }}
type: Opaque
stringData:
  MINIO_ROOT_USER: {{ vault_minio_root_user | to_json }}
  MINIO_ROOT_PASSWORD: {{ vault_minio_root_password | to_json }}
{% if mds_standalone_mode %}
---
# Standalone login (mock IAM form + API token check). Empty password = auto-login.
apiVersion: v1
kind: Secret
metadata:
  name: mds-login
  namespace: {{ mds_namespace }}
type: Opaque
stringData:
  MDS_LOGIN_USERNAME: {{ mds_standalone_login_username | to_json }}
  MDS_LOGIN_PASSWORD: {{ vault_standalone_login_password | default('') | to_json }}
{% endif %}
{% if not mds_standalone_mode %}
---
apiVersion: v1
kind: Secret
metadata:
  name: mds-iam
  namespace: {{ mds_namespace }}
type: Opaque
stringData:
  KEYCLOAK_CLIENT_SECRET: {{ vault_keycloak_client_secret | default('') | to_json }}
{% endif %}
{% if mds_backup_remote_enabled %}
---
apiVersion: v1
kind: Secret
metadata:
  name: mds-backup-remote
  namespace: {{ mds_namespace }}
type: Opaque
stringData:
  ACCESS_KEY: {{ vault_backup_remote_access_key | to_json }}
  SECRET_KEY: {{ vault_backup_remote_secret_key | to_json }}
{% endif %}
{% if mds_ingress_basic_auth_enabled %}
---
apiVersion: v1
kind: Secret
metadata:
  name: mds-basic-auth
  namespace: {{ mds_namespace }}
type: Opaque
stringData:
  auth: "{{ mds_ingress_basic_auth_user }}:{{ vault_ingress_basic_auth_password | password_hash('sha512', 65534 | random(seed=inventory_hostname) | string) }}"
{% endif %}
{% if mds_image_pull_secret | length > 0 %}
---
apiVersion: v1
kind: Secret
metadata:
  name: {{ mds_image_pull_secret }}
  namespace: {{ mds_namespace }}
type: kubernetes.io/dockerconfigjson
stringData:
  .dockerconfigjson: {{ {'auths': {vault_registry_server: {'username': vault_registry_username, 'password': vault_registry_password, 'auth': (vault_registry_username ~ ':' ~ vault_registry_password) | b64encode}}} | to_json | to_json }}
{% endif %}
