# Copy to hosts.ini (Terraform generates it automatically for AWS).
# Works with any Ubuntu 22.04/24.04 VMs: on-prem, Hetzner, Azure, GCP, etc.

[k3s_server]
mds-server-1 ansible_host=203.0.113.20 node_private_ip=10.40.1.10

[k3s_agents]
mds-agent-1 ansible_host=203.0.113.21 node_private_ip=10.40.1.11

[k3s_cluster:children]
k3s_server
k3s_agents

# Host(s) that run kubectl/helm/kubernetes.core tasks against the cluster.
# For an EXISTING cluster (EKS/AKS/GKE/RKE2), put a bastion here instead (or
# use `localhost ansible_connection=local`) and only run playbooks 02+.
[kube_control:children]
k3s_server

[all:vars]
ansible_user=ubuntu
ansible_ssh_private_key_file=~/.ssh/mds
ansible_python_interpreter=/usr/bin/python3
